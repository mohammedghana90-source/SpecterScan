# SpecterScan run artifacts — generated reports shouldn't be committed
specterscan_report.html
specterscan_report.csv
*.scan.json
scan.json
scan.html
scan.csv

# Local config overrides (keep the tracked config.json as the shared example)
config.local.json

# User-provided plugins are personal by nature — keep the examples/ folder
# tracked, but don't accidentally commit someone's real custom plugin.
# (plugins/*.py only matches files directly in plugins/, not
# plugins/examples/*.py, so the example file stays tracked automatically.)
plugins/*.py
